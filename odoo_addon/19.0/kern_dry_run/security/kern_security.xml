<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 removed res.groups.category_id and replaced it with privilege_id, a
         Many2one to the new res.groups.privilege model - that model is what now carries
         the ir.module.category link (odoo/addons/base/models/res_groups.py and
         res_groups_privilege.py). Core stock shows the same rewrite in 19.0
         (addons/stock/security/stock_security.xml). Leaving category_id here makes the
         module fail to install on 19: the field simply no longer exists.

         The privilege is Kern's own rather than stock's res_groups_privilege_inventory
         on purpose. A privilege renders as ONE select on the user form, so hanging this
         group off stock's Inventory privilege would make it mutually exclusive with
         Inventory User/Administrator - the opposite of what the comment below asks for. -->
    <record id="res_groups_privilege_kern" model="res.groups.privilege">
        <field name="name">Kern</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_kern_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_kern"/>
        <field name="comment">Can run Kern's external inventory analysis, which sends product identifiers, cost, supplier lead times, and confirmed sales history to Kern's cloud service. Deliberately separate from Inventory Administrator: managing warehouses/stock should not automatically grant permission to share data with a third-party service - grant this explicitly, per user, via Settings &gt; Users.</field>
    </record>
</odoo>
