# Kern environment — copy to `.env` and fill in as needed.
# Everything here is OPTIONAL: the engine, web app and tests all run with zero
# secrets. Missing keys degrade gracefully to the rules-based path; they never crash.
# `.env` is git-ignored (see .gitignore) — never commit real keys.

# --- Application -------------------------------------------------------------
# Enables Claude-assisted brief parsing and narrative generation in the agent
# (scm_agent/llm.py). Without it, the orchestrator uses the rules-based fallback.
# Requires the optional extra:  pip install -e ".[llm]"
ANTHROPIC_API_KEY=
# Typed intent routing with Jev (TypeSafe AI) for briefs the keyword rules cannot
# resolve (nosilo_core/llm.py::JevDecider, scm_agent/intent.py). No extra needed:
# the client is stdlib. Setting it SENDS those briefs to TypeSafe. Measure before
# relying on it: scripts/eval_intent_decider.py. TYPESAFE_MODEL defaults to jev-latest.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

# --- Web app hardening (opt-in; see SECURITY.md) -----------------------------
# All default to OFF so local/dev use is unchanged. Set these before a public deploy.
# Require a matching `X-API-Key` header on POST /api/jobs (unset = open):
LINCHPIN_API_KEY=
# Sliding-window rate limit per client IP; 0 disables. Window is in seconds:
LINCHPIN_RATE_LIMIT=0
LINCHPIN_RATE_WINDOW=60
# Comma-separated CORS allowlist (unset = same-origin only):
LINCHPIN_CORS_ORIGINS=
# Signs writeback Approvals (src/writeback.py) so one can't be forged by
# constructing it directly instead of calling approve() (unset = unsigned):
LINCHPIN_APPROVAL_SECRET=
# Path to the MCP per-client key store (src/mcp_keys.py). Defaults to
# data/mcp_keys.sqlite3 — on a platform with an ephemeral filesystem (e.g. a
# Railway deploy without a mounted Volume), point this at your persistent disk:
LINCHPIN_MCP_KEYS_PATH=
# Path to the canonical entity store (nosilo_core/entities/store.py). Defaults to
# data/entities.sqlite3 — same ephemeral-filesystem caveat as the key store above,
# and it matters more here: this one holds identity and history, not credentials
# that can be reissued:
LINCHPIN_ENTITIES_PATH=
# Tenant this deployment serves (nosilo_core.access). Single-tenant installs --
# which is every Kern install today -- can leave this alone:
LINCHPIN_TENANT=
# DANGEROUS unless you understand it. Set to 1 only when Kern runs behind a
# reverse proxy that terminates authentication AND strips any client-supplied
# X-Auth-* headers. With it on, webapp/principal.py takes X-Auth-Subject /
# X-Auth-Roles / X-Auth-Tenant at face value -- which is exactly what you want
# after OIDC at the edge, and a complete authentication bypass without it,
# because any caller can simply send the headers itself. Off = the headers are
# ignored entirely (the shipped default):
LINCHPIN_TRUSTED_IDENTITY_HEADERS=

# --- Production guard & logging (opt-in; see docs/DEPLOYMENT.md) --------------
# "production" makes the app warn loudly at boot if API key / rate limit / approval
# secret are unset:
LINCHPIN_ENV=development
# Set to 1 to REFUSE booting an unsecured production deploy (else it only warns):
LINCHPIN_REQUIRE_SECURE=
# Structured (JSON) access logs + level for the linchpin.access logger:
LINCHPIN_LOG_JSON=
LINCHPIN_LOG_LEVEL=INFO

# --- Odoo ERP connector (optional; src/connectors/odoo.py) -------------------
# Set all four to read inventory / sales from a live Odoo over XML-RPC and stage
# restocks back as reorder rules. Unset -> the connector still runs against an
# in-memory stand-in (examples/run_odoo.py), so no credentials are required to try it.
# API key: Odoo 14+  Settings -> Account Security -> Developer API Keys.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# --- Reading index (optional; src/connectors/lectura.py) ---------------------
# Absolute path to the PYTHON INTERPRETER of the separate `kern-lectura` repo -- the
# book index: 44 supply-chain books split into 6,929 passages, each with its physical
# PDF page. Set it and a package run (scm_agent/packages.py) attaches a short
# "reference readings" section to the consolidated deck: book + page label + a capped
# excerpt. UNSET (the default, and the only possible setting in production) means
# NOTHING happens: no server is started, no section is rendered, and every deliverable
# comes out byte for byte as it does today. Production cannot set it -- the index needs
# ~1.6 GB of RSS and the Fly VM has 512 MB (fly.toml) -- which is why "off" is the
# normal case, not a degraded one.
# What it is NOT: these passages are NOT Kern citations. A passage has no graph
# `node_id`, so `scm_agent/citation_gate.py` would reject it; the reading section lives
# strictly downstream of that gate and never touches the `citations` field. And the
# page label travels verbatim ("PDF p.83-84") because it is the PHYSICAL page of the
# PDF -- the printed folio of the book starts later (Vandeput: 26 pages of offset).
# One query per package run, ~17 s cold; a slow or absent index degrades to "no
# readings", never to a hung run.
# One book in the index has a destroyed PDF glyph map, so some passages come back as
# unreadable filler that still LOOKS like prose. The connector measures that
# (`lectura.MAX_RELLENO_EXCERPT`, calibrated on 400 real passages) and drops the
# EXCERPT while keeping book + page, which is complete provenance on its own: turning
# the index on can therefore yield reading entries with no quoted fragment. That is the
# intended outcome -- a quote the client cannot verify in the book is worse than no
# quote.
#   KERN_LECTURA_PYTHON=C:/Users/you/scm/kern-lectura/.venv/Scripts/python.exe
KERN_LECTURA_PYTHON=

# --- Tooling (not used at runtime) ------------------------------------------
# Only used by the external `graphify` CLI when (re)building the code graph
# (graphify-out/) with the Kimi backend. Not read by the app, engine, or tests.
MOONSHOT_API_KEY=
